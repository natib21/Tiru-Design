{
  "name": "@tirudesign/api-app",
  "version": "0.0.1",
  "private": false,
  "main": "dist/main.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "prestart": "prisma generate",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "echo 'no lint configured for api'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.0.0",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "bullmq": "^6.2.2",
    "chalk": "^6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "nanoid": "^6.0.1",
    "nestjs-zod": "^5.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "puppeteer": "^25.9.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.4",
    "winston": "^3.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.16.18",
    "@types/node": "^20.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/ui": "^5.0.5",
    "prisma": "^5.0.0",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.3.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^1.6.1"
