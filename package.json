{
  "name": "tirudesign",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.override.yml --env-file .env.dev up --build -d",
    "dev:client": "pnpm --filter @tirudesign/client dev",
    "dev:all": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @tirudesign/client test:e2e",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.override.yml --env-file .env.dev up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose -f docker-compose.yml -f docker-compose.override.yml --env-file .env.dev build",
    "docker:clean": "docker compose down -v",
    "docker:restart": "docker compose restart"
  },
  "devDependencies": {
    "turbo": "^1.12.3",
    "typescript": "^5.3.4",
    "eslint": "^8.52.0",
    "prettier": "^3.9.6"
  }
}
