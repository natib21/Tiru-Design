# Docker Environment Configuration
# This file shows the environment variables used in docker-compose.yml
# These are configured directly in docker-compose.yml and don't need a separate .env file

# ===========================
# API Configuration
# ===========================
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000

# ===========================
# Database Configuration
# ===========================
DATABASE_URL=postgresql://tirudesign:tirudesign_dev_password@postgres:5432/tirudesign
POSTGRES_USER=tirudesign
POSTGRES_PASSWORD=tirudesign_dev_password
POSTGRES_DB=tirudesign

# ===========================
# Redis Configuration
# ===========================
REDIS_URL=redis://redis:6379

# ===========================
# CORS Configuration
# ===========================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ===========================
# MinIO / S3 Configuration
# ===========================
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=tirudesign
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ===========================
# Frontend Configuration
# ===========================
VITE_API_URL=http://localhost:4001

# ===========================
# Monitoring (Optional)
# ===========================
SENTRY_DSN=

# ===========================
# NOTES:
# ===========================
# - These values are for DEVELOPMENT ONLY
# - For production, use strong passwords and secure secrets
# - MinIO credentials should be changed in production
# - Database passwords should be strong and unique
# - Consider using Docker secrets for production
