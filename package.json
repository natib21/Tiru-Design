{
  "name": "tirudesign",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tirudesign/client",
    "build": "npm run build --workspace=@tirudesign/client",
    "dev:client": "npm run dev --workspace=@tirudesign/client",
    "dev:all": "turbo run dev --parallel",
    "lint": "npm run lint --workspace=@tirudesign/client",
    "typecheck": "npm run typecheck --workspace=@tirudesign/client",
    "test": "npm run test --workspace=@tirudesign/client"
  },
  "devDependencies": {
    "turbo": "^1.12.3",
    "typescript": "^5.3.4",
    "eslint": "^8.52.0",
    "prettier": "^3.9.6"
  }
}