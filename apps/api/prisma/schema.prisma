generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailVerification {
  id         String    @id
  userId     String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  note      String?
}

model Membership {
  id          String           @id
  userId      String
  workspaceId String
  role        MembershipRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  User        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  Workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model PasswordResetToken {
  id         String    @id
  userId     String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PhoneVerification {
  id         String    @id
  userId     String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SecurityEvent {
  id        String            @id
  userId    String?
  eventType SecurityEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([createdAt])
  @@index([eventType])
  @@index([userId])
}

model Session {
  id                  String    @id
  userId              String
  currentRefreshHash  String?   @unique
  previousRefreshHash String
  expiresAt           DateTime
  revokedAt           DateTime?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  User                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model User {
  id                 String               @id
  email              String               @unique
  phoneNumber        String?              @unique
  passwordHash       String
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  status             UserStatus           @default(UNVERIFIED)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  lastLoginAt        DateTime?
  EmailVerification  EmailVerification[]
  Membership         Membership[]
  PasswordResetToken PasswordResetToken[]
  PhoneVerification  PhoneVerification[]
  Session            Session[]
  UserIdentity       UserIdentity[]

  @@index([status])
}

model UserIdentity {
  id             String       @id
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String?
  displayName    String?
  avatarUrl      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Workspace {
  id         String        @id
  type       WorkspaceType
  name       String
  plan       String        @default("free")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime
  Membership Membership[]

  @@index([type])
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum MembershipRole {
  OWNER
  EDITOR
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ACCOUNT_SUSPENDED
  ACCOUNT_DEACTIVATED
}

enum UserStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum WorkspaceType {
  PERSONAL
  TEAM
}
